PREFIX rcecw: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/creativework/>
PREFIX rcepe: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/person/>
PREFIX rcepl: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/place/>
PREFIX rcema: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/material/>
PREFIX rcege: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/definedterm/>
PREFIX rcemd: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/mediaobject/>


PREFIX schema: <http://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

PREFIX xmlns: <http://www.openarchives.org/OAI/2.0/>
PREFIX xsi: <http://www.w3.org/2001/XMLSchema-instance>

SOURCE oai_file <data/chunk/record_*.xml>

ITERATOR oai_records <xpath: //ListRecords/record> {
    FIELD id <header/identifier>
    FIELD datestamp <header/datestamp>
    FIELD spec <header/setSpec>
    FIELD priref <metadata/record/@priref>
    FIELD title <metadata/record/Title/title>
    FIELD description <metadata/record/Description/description>
    FIELD dimension <metadata/record/dimension.free>
    FIELD institution <metadata/record/institution.name>
    FIELD number_of_parts <metadata/record/number_of_parts>
    FIELD number_of_parts <metadata/record/number_of_parts>

    ITERATOR reproduction_it <metadata/record/Reproduction/> {
        FIELD reproduction_reference <reproduction.reference>
    }
    

    FIELD production_start_date <metadata/record/Production_date/production.date.start>
    FIELD production_end_date <metadata/record/Production_date/production.date.end>
    FIELD production_place_term <metadata/record/Production/production.place/term>
    FIELD production_place_uri <metadata/record/Production/production.place/Source/source.number>

    FIELD creator_priref <metadata/record/Production/creator/priref>
    FIELD creator_name <metadata/record/Production/creator/name>
    FIELD creator_birthplace <metadata/record/Production/creator/birth.place>
    FIELD creator_birthdate <metadata/record/Production/creator.date_of_birth>
    FIELD creator_deathdate <metadata/record/Production/creator.date_of_death>
    FIELD creator_uri <metadata/record/Production/creator/Source/source.number>

    ITERATOR material <metadata/record/Material> {
        FIELD material_term <material/term>
        FIELD material_uri <material/Source/source.number>
    }

    ITERATOR association_subject <metadata/record/Associated_subject> {
        FIELD association_subject_term <association.subject/term>
        FIELD association_subject_uri <association.subject/Source/source.number>
    }

    ITERATOR technique <metadata/record/Technique> {
        FIELD tech_term <technique/term>
    }

    ITERATOR object <metadata/record/Object_name> {
        FIELD object_term <object_name/term>
        FIELD object_uri <object_name/Source/source.number>
    }

    ITERATOR rights <metadata/record/Rights> {
        FIELD holder <rights.holder>
        FIELD type <rights.type>
        FIELD notes <rights.notes>
        FIELD assigned  <rights.assigned/value>
    }
}

EXPRESSION records <oai_file.oai_records> 
EXPRESSION placename <oai_file.oai_records.production_place_term UNION oai_file.oai_records.creator_birthplace>
EXPRESSION person_name <oai_file.oai_records.rights.holder UNION oai_file.oai_records.creator_name>
EXPRESSION defined_term_name <>

AUTOINCREMENT place_id <0>
AUTOINCREMENT material_id <0>
AUTOINCREMENT person_id <0>
AUTOINCREMENT genre_id <0>
AUTOINCREMENT mediaobject_id <0>

:CreativeWorks rcecw:[records.priref] {
    rdf:type schema:CreativeWork ;
    rdf:type schema:ItemList ;
    schema:name [records.title] ;
    schema:sdDatePublished [records.datestamp] ;
    schema:description [records.description] ;
    schema:publisher [records.institution] ;
    schema:size [records.dimension] ;
    schema:dateCreated [records.production_end_date] ;
    schema:associatedMedia @:MediaObjects ;
    schema:creator @:Persons ;
    schema:copyrightHolder @:Persons ;
    schema:contentLocation @:Places ;
    schema:locationCreated @:Places ;
    schema:about @:DefinedTerms ;
    schema:material @:Materials ;
    schema:genre @:DefinedTerms ;
    schema:identifier @:PropertyValues ;
}

:MediaObjects rcemd:[records.reproduction_it.reproduction_reference] {
    rdf:type schema:MediaObject ;
    EXPRESSION contenturl <"https://images.memorix.nl/rce/thumb/fullsize/" + records.reproduction_it.reproduction_reference +".jpg">
    EXPRESSION thumburl <"https://images.memorix.nl/rce/thumb/200x200/" + records.reproduction_it.reproduction_reference +".jpg">
    EXPRESSION kcrights <"https://rightsstatements.org/page/InC/1.0/?language=nl">
    schema:encodesCreativeWork  @:CreativeWork ;
    schema:contentUrl [contenturl] ;
    schema:thumbnailUrl [thumburl] ;
    schema:license [kcrights] ;
}

:Persons rcepe:[person_id] {
    rdf:type schema:Person ;
    schema:name [person_name]@nl ;
    schema:birthDate [records.creator_birthdate] ;
    schema:deathDate [records.creator_deathdate] ;
    schema:sameAs [records.creator_uri] ;
    schema:birthPlace @:Places ;
}

:Places rcepl:[place_id] {
    rdf:type schema:Place ; 
    schema:name [records.productionPlaceTerm] ;
    schema:sameAs [records.productionPlaceUri] ;
}

:Materials rcema:[material_id] {
    rdf:type schema:DefinedTerm ;
    rdf:type schema:Product ;
    schema:name [records.material.material_term]@nl ;
    schema:sameAs [records.material.material_uri] ;
}

:Genres rcege:[genre_id] {
    rdf:type schema:DefinedTerm ;
    schema:name [records.association_subject.association_subject_term]@nl ;
    schema:sameAs [records.association_subject.association_subject_uri]
}

:Places rcepl:[place_id] {
    rdf:type schema:Place ;
    schema:name [placename]@nl ;
    schema:sameAs [records.production_place_uri] ;
}

:PropertyValues rcepr:[property_value_id] {
    rdf:type schema:PropertyValue ;
}