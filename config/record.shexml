PREFIX rcecw: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/creativework/>
PREFIX rcep: <https://linkeddata.cultureelerfgoed.nl/rce/datacatalog/id/dataset/db6193aa-84af-3edf-90fd-074a0a11248d/person/>

PREFIX schema: <http://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SOURCE oai_file <data/records*.xml>

ITERATOR oai_records <xpath: //record> {
    FIELD id <header/identifier>
    FIELD datestamp <header/datestamp>
    FIELD spec <header/setSpec>
    FIELD priref <metadata/altrecord/@priref>
    FIELD title <metadata/altrecord/Title/title>
    FIELD description <metadata/altrecord/Description/description>
    FIELD dimension <metadata/altrecord/dimension.free>
    FIELD objectNumber <metadata/altrecord/object_number>
    FIELD institution <metadata/altrecord/institution.name>
    FIELD size <metadata/altrecord/dimension.free>
    FIELD numberOfParts <metadata/altrecord/number_of_parts>
    FIELD productionStart <metadata/altrecord/Production_date/production.date.start>
    FIELD productionEnd <metadata/altrecord/Production_date/production.date.end>
    FIELD productionPlace <metadata/altrecord/Production/production.place/term>
    FIELD creatorPriref <metadata/altrecord/Production/creator/priref>
    FIELD creatorName <metadata/altrecord/Production/creator/name>
    FIELD creatorBirthPlace <metadata/altrecord/Production/creator/birth.place>
    FIELD creatorBirthDate <metadata/altrecord/Production/creator.date_of_birth>
    FIELD creatorDeathDate <metadata/altrecord/Production/creator.date_of_death>
    FIELD creatorRKD <metadata/altrecord/Production/creator/Source/source.number>

    ITERATOR material <metadata/altrecord/Material> {
        FIELD term <material/term>
        FIELD uri <material/Source/source.number>
        FIELD part <material.part>
    }

    ITERATOR technique <metadata/altrecord/Technique> {
        FIELD term <technique/term>
        FIELD part <technique.part>
    }

    ITERATOR genre <metadata/altrecord/Object_name> {
        FIELD term <object_name/term>

    }

    ITERATOR rights <metadata/altrecord/Rights> {
        FIELD holder <rights.holder>
        FIELD type <rights.type>
        FIELD notes <rights.notes>
        FIELD assigned  <rights.assigned/value>
    }
}

EXPRESSION records <oai_file.oai_records> 

:Records rcecw:[records.priref] {
    rdf:type schema:CreativeWork ;
    schema:sdDatePublished [records.datestamp] ;
    schema:description [records.description] ;
    schema:size [records.dimension] ;
    schema:creator rcep:[records.creatorPriref] ;
}

:Persons rcep:[records.creatorPriref] {
    rdf:type schema:Person ;
    schema:name [records.creatorName]@nl ;
    schema:birthDate [records.creatorBirthDate] ;
    schema:deathDate [records.creatorDeathDate] ;
    schema:birthPlace [records.creatorBirthPlace]@nl ;
    schema:sameAs [records.creatorRKD] ;
}
